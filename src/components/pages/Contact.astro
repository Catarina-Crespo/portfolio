---
import { useTranslations, type Lang } from '../../i18n/utils';
import { site } from '../../config/site';
import SocialIcon from '../icons/SocialIcon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const socials = Object.entries(site.socials).filter(([, url]) => url);

// Add/remove/reorder project types here — each just needs a stable
// `value` and a translation key under contact.form.projectTypes.* in
// src/i18n/ui.ts.
const projectTypes = [
  'photography',
  'filming',
  'editing',
  'stopmotion',
  'motiongraphics',
  '3ddesign',
  'other',
] as const;
---

<section class="mx-auto max-w-7xl px-5 md:px-8 pt-16 pb-24">
  <div class="max-w-2xl" data-reveal>
    <p class="timecode text-amber-500 mb-3 flex items-center gap-2">
      <span class="h-px w-6 bg-amber-500/70"></span>
      {t('contact.eyebrow')}
    </p>
    <h1 class="font-display text-4xl sm:text-5xl font-semibold text-paper-100">{t('contact.title')}</h1>
    <p class="mt-5 text-lg text-paper-300 leading-relaxed">{t('contact.intro')}</p>
  </div>

  <div class="mt-14 grid gap-10 lg:grid-cols-[1.3fr_1fr]">
    <form
      data-contact-form
      action={site.contactFormEndpoint}
      method="POST"
      class="slate-frame rounded-[var(--radius-card)] border border-ink-700 bg-ink-900/50 p-6 sm:p-8 space-y-5"
      data-reveal
      data-reveal-delay="80"
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block">
          <span class="timecode text-paper-400">{t('contact.form.name')}</span>
          <input
            type="text"
            name="name"
            required
            class="mt-2 w-full rounded border border-ink-700 bg-ink-950/60 px-3.5 py-2.5 text-paper-100 outline-none transition-colors focus:border-amber-500"
          />
        </label>
        <label class="block">
          <span class="timecode text-paper-400">{t('contact.form.email')}</span>
          <input
            type="email"
            name="email"
            required
            class="mt-2 w-full rounded border border-ink-700 bg-ink-950/60 px-3.5 py-2.5 text-paper-100 outline-none transition-colors focus:border-amber-500"
          />
        </label>
      </div>

      <label class="block">
        <span class="timecode text-paper-400">{t('contact.form.projectType')}</span>
        <div class="relative mt-2">
          <select
            name="projectType"
            required
            class="w-full appearance-none rounded border border-ink-700 bg-ink-950/60 px-3.5 py-2.5 pr-9 text-paper-100 outline-none transition-colors focus:border-amber-500"
          >
            <option value="" selected disabled>{t('contact.form.projectTypePlaceholder')}</option>
            {projectTypes.map((key) => (
              <option value={key}>{t(`contact.form.projectTypes.${key}` as any)}</option>
            ))}
          </select>
          <svg viewBox="0 0 24 24" class="pointer-events-none absolute right-3 top-1/2 h-4 w-4 -translate-y-1/2 fill-none stroke-paper-400" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </div>
      </label>

      <label class="block">
        <span class="timecode text-paper-400">{t('contact.form.subject')}</span>
        <input
          type="text"
          name="subject"
          required
          class="mt-2 w-full rounded border border-ink-700 bg-ink-950/60 px-3.5 py-2.5 text-paper-100 outline-none transition-colors focus:border-amber-500"
        />
      </label>
      <label class="block">
        <span class="timecode text-paper-400">{t('contact.form.message')}</span>
        <textarea
          name="message"
          rows="5"
          required
          class="mt-2 w-full rounded border border-ink-700 bg-ink-950/60 px-3.5 py-2.5 text-paper-100 outline-none transition-colors focus:border-amber-500"
        ></textarea>
      </label>

      <div class="flex items-center gap-4">
        <button
          type="submit"
          data-contact-submit
          class="inline-flex items-center gap-2 rounded bg-amber-500 px-6 py-3 timecode text-ink-950 transition-colors hover:bg-amber-400 disabled:opacity-60"
        >
          <span data-submit-label>{t('contact.form.submit')}</span>
        </button>
        <p data-contact-status role="status" class="timecode hidden"></p>
      </div>
    </form>

    <div class="space-y-6" data-reveal data-reveal-delay="140">
      <div class="rounded-[var(--radius-card)] border border-ink-700 bg-ink-900/50 p-6">
        <p class="timecode text-amber-500 mb-4">{t('contact.direct.title')}</p>
        <a href={`mailto:${site.email}`} class="block text-paper-100 hover:text-amber-400 transition-colors">{site.email}</a>
        {site.phone && <a href={`tel:${site.phone.replace(/\s+/g, '')}`} class="block mt-1 text-paper-300 hover:text-amber-400 transition-colors">{site.phone}</a>}
      </div>

      {socials.length > 0 && (
        <div class="rounded-[var(--radius-card)] border border-ink-700 bg-ink-900/50 p-6">
          <p class="timecode text-amber-500 mb-4">{t('contact.social.title')}</p>
          <ul class="space-y-2">
            {socials.map(([name, url]) => (
              <li>
                <a href={url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2.5 capitalize text-paper-300 hover:text-amber-400 transition-colors">
                  <SocialIcon name={name} class="h-4 w-4" />
                  {name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="rounded-[var(--radius-card)] border border-ink-700 bg-ink-900/50 p-6">
        <p class="timecode text-amber-500 mb-4">{t('contact.location.title')}</p>
        <p class="text-paper-300">{lang === 'en' ? site.location.en : site.location.pt}</p>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ sendingLabel: t('contact.form.sending'), submitLabel: t('contact.form.submit'), successMsg: t('contact.form.success'), errorMsg: t('contact.form.error') }}>
  function initContactForm() {
    const form = document.querySelector('[data-contact-form]');
    if (!form) return;
    const submitBtn = form.querySelector('[data-contact-submit]');
    const submitLabelEl = form.querySelector('[data-submit-label]');
    const status = form.querySelector('[data-contact-status]');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (submitBtn.disabled) return;

      submitBtn.disabled = true;
      if (submitLabelEl) submitLabelEl.textContent = sendingLabel;
      if (status) {
        status.classList.add('hidden');
        status.classList.remove('text-amber-500', 'text-rec-500');
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          form.reset();
          if (status) {
            status.textContent = successMsg;
            status.classList.remove('hidden');
            status.classList.add('text-amber-500');
          }
        } else {
          throw new Error('Form submission failed');
        }
      } catch {
        if (status) {
          status.textContent = errorMsg;
          status.classList.remove('hidden');
          status.classList.add('text-rec-500');
        }
      } finally {
        submitBtn.disabled = false;
        if (submitLabelEl) submitLabelEl.textContent = submitLabel;
      }
    });
  }

  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>
