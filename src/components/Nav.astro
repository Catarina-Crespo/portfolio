---
import { useTranslations, localizePath, type Lang } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { site } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: localizePath('/', lang), label: t('nav.home'), match: '/' },
  { href: localizePath('/filming', lang), label: t('nav.filming'), match: '/filming' },
  { href: localizePath('/photography', lang), label: t('nav.photography'), match: '/photography' },
  { href: localizePath('/stop-motion', lang), label: t('nav.stopmotion'), match: '/stop-motion' },
  { href: localizePath('/other-works', lang), label: t('nav.other'), match: '/other-works' },
  { href: localizePath('/about', lang), label: t('nav.about'), match: '/about' },
  { href: localizePath('/contact', lang), label: t('nav.contact'), match: '/contact' },
];

// Work out the "bare" current path (without /pt prefix) to mark the active link.
const parts = Astro.url.pathname.split('/').filter(Boolean);
if (parts[0] === 'pt') parts.shift();
const currentPath = '/' + parts.join('/');
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-ink-700/70 bg-ink-950/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-3 md:px-8">
    <a href={localizePath('/', lang)} class="group flex items-center gap-2">
      <span class="font-handwritting text-3xl font-semibold tracking-tight text-paper-100">
        {site.name}
      </span>
    </a>

    <div class="flex items-center gap-6">
      <nav class="hidden lg:flex items-center gap-7" aria-label="Primary">
        {links.map((link) => (
          <a
            href={link.href}
            class="nav-box timecode text-paper-300 hover:text-paper-100 transition-colors"
            aria-current={currentPath === link.match ? 'page' : undefined}
          >
            <span>{link.label}</span>
          </a>
        ))}
      </nav>

      <button
        type="button"
        data-nav-toggle
        class="lg:hidden inline-flex flex-col items-center justify-center gap-1.5 h-9 w-9 rounded border border-ink-700 text-paper-100"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
      >
        <span class="sr-only">{t('nav.menu')}</span>
        <span data-nav-bar class="block h-px w-4 bg-current transition-transform duration-300"></span>
        <span data-nav-bar class="block h-px w-4 bg-current transition-opacity duration-300"></span>
        <span data-nav-bar class="block h-px w-4 bg-current transition-transform duration-300"></span>
      </button>
    </div>
  </div>
</header>

<!--
  Deliberately NOT nested inside <header>: that element has
  backdrop-blur (backdrop-filter), and any non-none backdrop-filter/
  filter/transform on an ancestor makes THAT ancestor the containing
  block for position:fixed descendants instead of the viewport. Since
  header is only ~57px tall, this panel's "bottom: 0" was resolving
  against the header's own bottom edge (~57px down) rather than the
  screen's, collapsing its real height to almost nothing — which is
  why the background only ever painted a sliver and everything below
  it showed the page through. Being a sibling instead means the
  viewport is its containing block again, same as before.
-->
<div
  id="mobile-nav-panel"
  data-nav-panel
  class="mobile-panel lg:hidden"
>
  <nav class="flex flex-col gap-1 px-6 py-8" aria-label="Mobile">
    {links.map((link, i) => (
      <a
        href={link.href}
        data-nav-link
        class="timecode py-3 text-2xl font-display normal-case tracking-tight text-paper-200 border-b border-ink-800"
        aria-current={currentPath === link.match ? 'page' : undefined}
      >
        <span class="text-amber-500 mr-3 text-sm align-middle">0{i + 1}</span>{link.label}
      </a>
    ))}
  </nav>
  <div class="px-6">
    <LanguageSwitcher lang={lang} />
  </div>
</div>

<script>
  function initNav() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const panel = document.querySelector<HTMLElement>('[data-nav-panel]');
    if (!toggle || !panel) return;

    const bars = toggle.querySelectorAll<HTMLElement>('[data-nav-bar]');

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('is-open', open);
      document.body.classList.toggle('overflow-hidden', open);
      if (bars[0]) bars[0].style.transform = open ? 'translateY(6px) rotate(45deg)' : '';
      if (bars[1]) bars[1].style.opacity = open ? '0' : '1';
      if (bars[2]) bars[2].style.transform = open ? 'translateY(-6px) rotate(-45deg)' : '';
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      setOpen(!isOpen);
    });

    panel.querySelectorAll('[data-nav-link]').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });

    // Reset state (important across Astro view-transitions).
    setOpen(false);
  }

  // astro:page-load fires on the initial load too, so a separate direct
  // call here would double-init this: two click listeners would both
  // read aria-expanded on the same click, and the second one would read
  // the value the first one just set, immediately toggling it back —
  // which is exactly why the mobile menu wasn't opening.
  document.addEventListener('astro:page-load', initNav);
</script>
