---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<div class="mx-auto max-w-7xl px-5 pb-6 pt-8 md:px-8 md:pt-10" data-reveal>
  <div class="flex flex-col gap-3 border-b border-ink-800 pb-6 md:flex-row md:items-end md:justify-between md:gap-8">
    <div>
      <p class="timecode mb-2 flex items-center gap-2 text-amber-500">
        <span class="h-px w-6 bg-amber-500/70"></span>
        {eyebrow}
      </p>
      <h1 class="font-display text-3xl font-semibold text-paper-100 sm:text-4xl">{title}</h1>
    </div>
    {description && <p class="max-w-sm text-sm leading-relaxed text-paper-400 md:text-right">{description}</p>}
  </div>
</div>
