---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}
const { eyebrow, title, description, align = 'left', class: className = '' } = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' ? 'mx-auto text-center' : '', className]} data-reveal>
  {eyebrow && (
    <p class="timecode text-amber-500 mb-3 flex items-center gap-2" class:list={[align === 'center' ? 'justify-center' : '']}>
      <span class="h-px w-6 bg-amber-500/70"></span>
      {eyebrow}
    </p>
  )}
  <h2 class="font-display text-3xl sm:text-4xl font-semibold text-paper-100">{title}</h2>
  {description && <p class="mt-4 text-paper-300 leading-relaxed">{description}</p>}
</div>
