---
import { getVideoProvider, getBackgroundEmbedUrl, getAutoThumbnail } from '../utils/media';

interface Props {
  videoUrl?: string;
  thumbnail?: string;
  title: string;
  class?: string;
}
const { videoUrl, thumbnail, title, class: className = '' } = Astro.props;

const provider = videoUrl ? getVideoProvider(videoUrl) : 'unknown';
const embedUrl = videoUrl ? getBackgroundEmbedUrl(videoUrl) : null;
const poster = thumbnail || (videoUrl ? getAutoThumbnail(videoUrl) : null);
---

<div class={`h-full w-full overflow-hidden bg-ink-900 ${className}`} aria-hidden="true">
  {embedUrl ? (
    <iframe
      data-bg-video-embed
      data-bg-video-provider={provider}
      src={embedUrl}
      title={title}
      class="pointer-events-none absolute inset-0 h-full w-full"
      allow="autoplay; encrypted-media"
      tabindex="-1"
    />
  ) : provider === 'file' && videoUrl ? (
    <video
      data-bg-video-file
      src={videoUrl}
      poster={poster ?? undefined}
      class="pointer-events-none absolute inset-0 h-full w-full object-cover"
      autoplay
      muted
      loop
      playsinline
      webkit-playsinline="true"
      tabindex="-1"
    />
  ) : poster ? (
    <img src={poster} alt="" class="absolute inset-0 h-full w-full object-cover" />
  ) : (
    <div class="absolute inset-0 bg-gradient-to-br from-ink-800 to-ink-900" />
  )}
</div>

<script>
  // iOS Safari is notably stricter than desktop browsers about one thing
  // in particular: the plain `autoplay` HTML attribute is fairly reliable
  // on a genuine full page load, but much less so for video that gets
  // inserted into the page via JavaScript — which is exactly what happens
  // every time Astro's client-side routing swaps this page back in after
  // visiting another page. So rather than trust the attribute alone, this
  // explicitly (and repeatedly) asks the video/embed to play, tied to
  // real readiness signals instead of a single arbitrary delay.
  function sendPlayCommand(iframe: HTMLIFrameElement, provider: string) {
    if (!iframe.contentWindow) return;
    if (provider === 'youtube') {
      iframe.contentWindow.postMessage(JSON.stringify({ event: 'command', func: 'playVideo', args: [] }), '*');
    } else if (provider === 'vimeo') {
      iframe.contentWindow.postMessage(JSON.stringify({ method: 'play' }), '*');
    }
  }

  function initBackgroundVideo() {
    const iframe = document.querySelector<HTMLIFrameElement>('[data-bg-video-embed]');
    const video = document.querySelector<HTMLVideoElement>('[data-bg-video-file]');
    if (!iframe && !video) return;

    const kick = () => {
      if (iframe) sendPlayCommand(iframe, iframe.dataset.bgVideoProvider || '');
      if (video && video.paused) video.play().catch(() => {});
    };

    kick();

    if (video) {
      // Catch it the moment the browser itself considers it playable,
      // rather than guessing at a delay.
      video.addEventListener('loadeddata', kick);
      video.addEventListener('canplay', kick);
    }
    if (iframe) {
      iframe.addEventListener('load', kick);
    }

    // Belt-and-suspenders: keep nudging it for a few seconds after init.
    // For local video this stops as soon as it's confirmed playing; for
    // the iframe case we can't read its play state (cross-origin), so it
    // just keeps sending the (harmless, idempotent) play command a fixed
    // number of times.
    let attempts = 0;
    const maxAttempts = 8;
    const retry = window.setInterval(() => {
      attempts += 1;
      if (video && !video.paused) {
        window.clearInterval(retry);
        return;
      }
      kick();
      if (attempts >= maxAttempts) window.clearInterval(retry);
    }, 500);

    // Any of these guarantee the browser will allow playback, so they
    // double as a safety net regardless of why autoplay didn't fire.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') kick();
    });
    // Covers the phone's own back/forward gesture restoring a bfcached
    // page — a different mechanism than Astro's client-side routing, and
    // one that commonly leaves autoplaying video paused on iOS.
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) kick();
    });
    (['pointerdown', 'touchstart', 'keydown'] as const).forEach((evt) => {
      document.addEventListener(evt, kick, { once: true, passive: true });
    });
  }

  document.addEventListener('astro:page-load', initBackgroundVideo);
</script>
