---
interface Props {
  src: string;
  alt: string;
  ariaHidden?: boolean;
}
const { src, alt, ariaHidden = false } = Astro.props;
---

<div
  class="slate-frame group relative h-[260px] w-[260px] shrink-0 overflow-hidden rounded-[var(--radius-card)] bg-ink-900 sm:h-[300px] sm:w-[300px]"
  aria-hidden={ariaHidden ? 'true' : undefined}
>
  <img
    src={src}
    alt={ariaHidden ? '' : alt}
    loading="lazy"
    class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.06]"
  />
</div>
